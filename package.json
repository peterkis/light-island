{
  "name": "samewave-island-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "instructions:check": "node scripts/check-project-guidance.mjs",
    "check": "npm run instructions:check && npm test && npm run test:protocol && npm run build && npm run bundle:check",
    "dev": "vite --host 127.0.0.1",
    "demo:server": "node server/demo-server.mjs",
    "dev:all": "concurrently -k -n WEB,DEMO \"npm:dev\" \"npm:demo:server\"",
    "build": "npm run tokens:clinical && npm run tokens:lab && npm run typecheck && vite build --mode island && vite build --mode workbench",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "tauri": "tauri",
    "desktop:dev": "node scripts/desktop-app.mjs dev island",
    "desktop:build": "node scripts/desktop-app.mjs build all",
    "tokens:clinical": "node scripts/generate-clinical-tokens.mjs",
    "tokens:lab": "node scripts/generate-lab-tokens.mjs",
    "clinical:server": "node scripts/start-clinical-development.mjs",
    "dev:clinical": "concurrently -k -n WEB,CLINICAL \"npm:dev\" \"npm:clinical:server\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tools.json",
    "bundle:check": "node scripts/check-source-bundle.mjs && node scripts/check-app-bundles.mjs",
    "profile:baseline": "node scripts/prepare-optimization-baseline.mjs",
    "build:island": "npm run tokens:clinical && npm run tokens:lab && tsc --noEmit -p tsconfig.json && vite build --mode island",
    "build:workbench": "tsc --noEmit -p tsconfig.json && vite build --mode workbench",
    "desktop:build:island": "node scripts/desktop-app.mjs build island",
    "desktop:build:workbench": "node scripts/desktop-app.mjs build workbench",
    "desktop:dev:island": "node scripts/desktop-app.mjs dev island",
    "desktop:dev:workbench": "node scripts/desktop-app.mjs dev workbench",
    "test:protocol": "node scripts/source-contract.mjs --check"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@tauri-apps/api": "^2.8.0",
    "gsap": "3.15.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "tailwindcss": "4.3.3",
    "typescript": "~5.9.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.4",
    "ws": "^8.18.3"
  }
}
